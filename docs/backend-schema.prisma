// HomeHub — relational data model for the planned full-stack version (PostgreSQL + Prisma).
//
// STATUS: design document only. The shipped app runs in local mode (IndexedDB, see
// src/data/). This schema mirrors src/types/models.ts so the data layer can be swapped for an
// API without changing the UI. It is not used by any code in this repository.
//
// Conventions
// - Money: integer minor units (BigInt-safe Int; INR paise). Never floats.
// - Date-only values (`@db.Date`) are interpreted in Household.timeZone; timestamps are UTC.
// - Every household-owned table has `householdId` + FK + index; the API must derive the
//   household from the authenticated membership, never trust one sent by the client.
// - Derived statuses (overdue, due soon, low stock, expiring) are computed, not stored.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum HouseholdType {
  INDIVIDUAL
  COUPLE
  FAMILY
  ROOMMATES
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  avatarColor  String
  passwordHash String // argon2id
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions    Session[]
  memberships HouseholdMembership[]
  preference  UserPreference?
}

model Session {
  id        String   @id // random 256-bit id, stored only in an HttpOnly, Secure, SameSite=Lax cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Household {
  id                      String        @id @default(uuid())
  name                    String
  type                    HouseholdType
  description             String?
  currency                String        @db.Char(3)
  timeZone                String
  enabledModules          String[]
  customExpenseCategories String[]
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  memberships HouseholdMembership[]
  invitations HouseholdInvitation[]
}

model HouseholdMembership {
  id          String    @id @default(uuid())
  householdId String
  userId      String
  role        Role
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([householdId, userId])
  @@index([userId])
}

model HouseholdInvitation {
  id          String           @id @default(uuid())
  householdId String
  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  tokenHash   String           @unique // SHA-256 of the 256-bit token; the raw token is only shown once
  role        Role
  label       String?
  createdById String
  expiresAt   DateTime
  status      InvitationStatus @default(PENDING)
  acceptedById String?
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  @@index([householdId, status])
}

model InventoryCategory {
  id          String @id @default(uuid())
  householdId String
  name        String

  @@unique([householdId, name])
}

model InventoryLocation {
  id          String @id @default(uuid())
  householdId String
  name        String

  @@unique([householdId, name])
}

model InventoryItem {
  id                 String    @id @default(uuid())
  householdId        String
  name               String
  categoryId         String
  locationId         String
  quantity           Decimal   @db.Decimal(12, 3)
  unit               String
  minQuantity        Decimal   @db.Decimal(12, 3)
  purchasePriceMinor Int?
  purchaseDate       DateTime? @db.Date
  expiryDate         DateTime? @db.Date
  barcode            String?
  notes              String?
  archived           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  movements InventoryMovement[]

  @@index([householdId, archived])
  @@index([householdId, expiryDate])
}

model InventoryMovement {
  id                   String        @id @default(uuid())
  householdId          String
  itemId               String
  item                 InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type                 String // initial | restock | consume | adjust | purchase
  delta                Decimal       @db.Decimal(12, 3)
  quantityAfter        Decimal       @db.Decimal(12, 3)
  note                 String?
  actorId              String
  occurredAt           DateTime
  sourceShoppingItemId String?       @unique // one purchase movement per shopping item

  @@index([householdId, itemId, occurredAt])
}

model ShoppingList {
  id             String   @id @default(uuid())
  householdId    String
  name           String
  archived       Boolean  @default(false)
  createdById    String
  lastActivityAt DateTime
  createdAt      DateTime @default(now())

  items ShoppingItem[]

  @@index([householdId, archived])
}

model ShoppingItem {
  id                  String       @id @default(uuid())
  householdId         String
  listId              String
  list                ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  name                String
  quantity            Decimal      @db.Decimal(12, 3)
  unit                String
  categoryId          String?
  estimatedPriceMinor Int?
  actualPriceMinor    Int?
  priority            String
  notes               String?
  purchased           Boolean      @default(false)
  purchasedAt         DateTime?
  purchasedById       String?
  addedById           String
  sortOrder           Int
  inventoryItemId     String?
  receivedAt          DateTime?
  expenseId           String?      @unique
  clearedAt           DateTime?
  version             Int          @default(0) // optimistic concurrency for concurrent edits

  @@index([householdId, listId, purchased])
}

model Task {
  id                    String    @id @default(uuid())
  householdId           String
  title                 String
  description           String?
  category              String
  assigneeId            String?
  dueDate               DateTime? @db.Date
  dueTime               String?
  priority              String
  status                String // not_started | in_progress | completed (overdue is derived)
  recurrence            Json?
  seriesId              String?
  checklist             Json      @default("[]")
  notes                 String?
  reminderMinutesBefore Int?
  completedAt           DateTime?
  completedById         String?
  boardOrder            Int       @default(0)
  createdById           String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  comments TaskComment[]

  @@unique([seriesId, dueDate]) // one occurrence per series per date
  @@index([householdId, status, dueDate])
  @@index([householdId, assigneeId])
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  text      String
  createdAt DateTime @default(now())
}

model Bill {
  id          String   @id @default(uuid())
  householdId String
  name        String
  category    String
  amountMinor Int
  startDate   DateTime @db.Date
  recurrence  Json?
  payerId     String?
  notes       String?
  active      Boolean  @default(true)

  occurrences BillOccurrence[]

  @@index([householdId, active])
}

model BillOccurrence {
  id              String    @id @default(uuid())
  householdId     String
  billId          String
  bill            Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  originalDate    DateTime  @db.Date
  dueDate         DateTime  @db.Date
  amountMinor     Int
  state           String // open | paid | cancelled
  paidAt          DateTime? @db.Date
  paidAmountMinor Int?
  paidById        String?
  expenseId       String?   @unique
  notes           String?

  @@unique([billId, originalDate]) // generation is idempotent
  @@index([householdId, state, dueDate])
}

model Expense {
  id               String         @id @default(uuid())
  householdId      String
  description      String
  amountMinor      Int
  date             DateTime       @db.Date
  category         String
  payerId          String
  paymentMethod    String?
  notes            String?
  receiptDocumentId String?
  source           String // manual | shopping | bill | maintenance
  sourceId         String?
  splitMethod      String? // equal | percentage | amount
  createdAt        DateTime       @default(now())

  shares ExpenseShare[]

  @@unique([source, sourceId]) // a source record can create at most one expense
  @@index([householdId, date])
  @@index([householdId, category])
}

model ExpenseShare {
  expenseId  String
  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId     String
  shareMinor Int
  percentBp  Int?

  @@id([expenseId, userId])
}

model Settlement {
  id          String   @id @default(uuid())
  householdId String
  fromUserId  String
  toUserId    String
  amountMinor Int
  date        DateTime @db.Date
  note        String?

  @@index([householdId, date])
}

model Budget {
  householdId    String @id
  overallMinor   Int?
  warningPercent Int
  categories     Json // [{ category, limitMinor }]
}

model Asset {
  id                 String    @id @default(uuid())
  householdId        String
  name               String
  category           String
  manufacturer       String?
  model              String?
  serialNumber       String?
  purchaseDate       DateTime? @db.Date
  purchasePriceMinor Int?
  warrantyExpiry     DateTime? @db.Date
  location           String?
  notes              String?
  archived           Boolean   @default(false)

  @@index([householdId, warrantyExpiry])
}

model MaintenanceTask {
  id                 String   @id @default(uuid())
  householdId        String
  name               String
  assetId            String?
  description        String?
  dueDate            DateTime @db.Date
  recurrence         Json?
  seriesId           String?
  priority           String
  assigneeId         String?
  provider           String?
  estimatedCostMinor Int?
  status             String // scheduled | completed | cancelled
  notes              String?
  recordId           String?  @unique

  @@unique([seriesId, dueDate])
  @@index([householdId, status, dueDate])
}

model MaintenanceRecord {
  id                String   @id @default(uuid())
  householdId       String
  assetId           String?
  maintenanceTaskId String?  @unique
  completedDate     DateTime @db.Date
  workPerformed     String
  provider          String?
  actualCostMinor   Int?
  notes             String?
  expenseId         String?  @unique
  recordedById      String

  @@index([householdId, assetId, completedDate])
}

model CalendarEvent {
  id                    String    @id @default(uuid())
  householdId           String
  title                 String
  description           String?
  category              String
  date                  DateTime  @db.Date
  endDate               DateTime? @db.Date
  allDay                Boolean
  startTime             String?
  endTime               String?
  location              String?
  memberIds             String[]
  recurrence            Json?
  reminderMinutesBefore Int?
  createdById           String

  @@index([householdId, date])
}

model Document {
  id          String    @id @default(uuid())
  householdId String
  title       String
  category    String
  fileName    String
  mimeType    String
  size        Int
  storageKey  String    @unique // private object-storage key; downloads use short-lived signed URLs
  notes       String?
  expiryDate  DateTime? @db.Date
  links       Json      @default("[]")
  archived    Boolean   @default(false)
  uploadedById String
  createdAt   DateTime  @default(now())

  @@index([householdId, category])
}

model ActivityLog {
  id          String   @id @default(uuid())
  householdId String
  actorId     String
  entity      String
  entityId    String?
  message     String
  createdAt   DateTime @default(now())

  @@index([householdId, createdAt])
}

model NotificationState {
  userId      String
  householdId String
  key         String
  readAt      DateTime?
  dismissedAt DateTime?

  @@id([userId, key])
}

model UserPreference {
  userId        String @id
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme         String
  motion        String
  notifications Json
}

model DashboardLayout {
  userId      String
  householdId String
  widgets     Json

  @@id([userId, householdId])
}

/// Idempotency keys for multi-record financial / inventory operations (same role as the
/// `operations` store in local mode). Inserted in the same transaction as the operation.
model OperationKey {
  householdId String
  key         String
  createdAt   DateTime @default(now())

  @@id([householdId, key])
}
